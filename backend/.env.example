
# Шаблон переменных окружения для backend.
#
# Как использовать:
#   1. Скопируйте этот файл:  cp .env.example .env   (Windows: copy)
#   2. Заполните реальными значениями.
#   3. ФАЙЛ .env НЕ КОММИТИТСЯ — он исключён через .gitignore.

# --- PostgreSQL ---
DB_HOST=localhost
DB_NAME=postgres
DB_USER=postgres
# Пароль пользователя БД — обязательно замените!
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_PORT=55432

# --- Секретные ключи ---
# Ключ подписи JWT-токенов доступа (flask-jwt-extended).
# Сгенерируйте свой:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY
# Ключ подписи токенов сброса пароля (PyJWT, HS256).
# Сгенерируйте свой:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_RESET_TOKEN_SECRET_KEY

# --- SMTP (Gmail) ---
# Для Gmail нужен «пароль приложения», а не обычный пароль от аккаунта:
# включите двухфакторную аутентификацию и создайте пароль приложения на
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
MAIL_DEFAULT_SENDER=your_email@gmail.com

# --- Ссылки ---
# Базовый URL фронтенда — используется в письмах со ссылкой сброса пароля.
FRONTEND_BASE_URL=http://127.0.0.1:5500
